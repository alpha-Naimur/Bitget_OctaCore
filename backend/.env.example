# ==============================================================================
# BITGET OCTACORE - CONFIGURATION ENVIRONMENT
# Institutional Multi-Agent AI System for Bitget AI Base Camp Hackathon S2
# ==============================================================================

# Execution Mode: SIMULATION | TESTNET | MAINNET | SUB_ACCOUNT
EXECUTION_MODE=SIMULATION

# Bitget Agentic Account OAuth (Primary Authentication - Recommended)
# Run 'python main.py --login' or type 'login' in the CLI to authenticate via browser OAuth.
# Tokens are automatically written to: ~/.bitget/oauth_token.json
BITGET_OAUTH_ENABLED=true
# BITGET_OAUTH_TOKEN_PATH=  # (Optional override: defaults to ~/.bitget/oauth_token.json)

# Bitget API Credentials (Fallback / Legacy Manual Keys)
# Optional: Only needed if you do not use Agentic Account OAuth.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
BITGET_SUB_ACCOUNT_UID=

# Bitget Endpoints
BITGET_REST_URL=https://api.bitget.com
BITGET_DEMO_REST_URL=https://api.bitget.com
BITGET_WS_URL=wss://ws.bitget.com/v2/ws/public

# LLM Engine Configuration
# Providers: qwen | gemini | openrouter | rule_based
LLM_PROVIDER=qwen
LLM_MODEL=qwen3.8-max
LLM_TEMPERATURE=0.2

# Alibaba Cloud Qwen (Official Token Sponsor for Bitget Hackathon S2)
# Base URL provided by Bitget Ops: https://hackathon.bitgetops.com/v1
BITGET_QWEN_API_KEY=
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1

# Google GenAI / Gemini Fallback
GEMINI_API_KEY=
GOOGLE_API_KEY=

# OpenRouter Fallback
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Risk Guardian & Circuit Breaker Guardrails
MAX_POSITION_SIZE_USD=1000.0
MAX_DRAWDOWN_PERCENT=5.0
MAX_SINGLE_ORDER_USD=500.0
DAILY_TRADE_LIMIT=20
MAX_SLIPPAGE_PERCENT=1.0
EMERGENCY_KILL_SWITCH_ACTIVE=false

# Paper Trading Simulator Defaults
SIMULATOR_INITIAL_USDT=10000.0
SIMULATOR_FUTURES_MARGIN_USDT=2000.0

# News Sentinel & Macro Radar
NEWS_SENTINEL_ENABLED=true
NEWS_POLL_INTERVAL_SECONDS=60
